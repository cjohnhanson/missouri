#!/bin/sh
# Compare two JSON files semantically (key order doesn't matter).
# Uses python since it's ubiquitous.
python3 -c "
import json, sys
a = json.load(open(sys.argv[1]))
b = json.load(open(sys.argv[2]))
if a != b:
    print(f'JSON mismatch:\n  left:  {a}\n  right: {b}', file=sys.stderr)
    sys.exit(1)
" "$1" "$2"
